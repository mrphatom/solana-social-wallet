{
  "name": "solana-social-wallet",
  "version": "0.2.0",
  "private": true,
  "description": "Security-first, non-custodial Solana account coordination and verifiable social-tip directory foundation for Discord and Telegram.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "tsx src/index.ts",
    "demo": "tsx src/demo.ts",
    "build": "tsc --project tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "eslint": "^10.9.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vitest": "^4.0.15"
  }
}
